    {
      "name": "1. Organizador",
      "item": [
        {
          "name": "Crear evento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/eventos",
            "description": "Crea el evento de la demo con las 4 categorías. Guarda su id en {{eventoId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Concierto de la demo\",\n  \"lugar\": \"Movistar Arena\",\n  \"fechaInicio\": \"{{fechaFutura}}\",\n  \"aforoMaximo\": 10,\n  \"organizadorId\": \"{{organizadorId}}\",\n  \"organizadorCorreo\": \"organizador@eventhub.test\",\n  \"categorias\": [\n    {\n      \"tipo\": \"GENERAL\",\n      \"cupos\": 5,\n      \"precioBase\": 80000\n    },\n    {\n      \"tipo\": \"VIP\",\n      \"cupos\": 3,\n      \"precioBase\": 250000\n    },\n    {\n      \"tipo\": \"ESTUDIANTE\",\n      \"cupos\": 1,\n      \"precioBase\": 40000\n    },\n    {\n      \"tipo\": \"CORTESIA\",\n      \"cupos\": 1,\n      \"precioBase\": 0\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha de inicio: dentro de 30 días (el dominio rechaza fechas pasadas).",
                  "const f = new Date(Date.now() + 30*24*60*60*1000);",
                  "pm.collectionVariables.set('fechaFutura', f.toISOString().replace(/\\.\\d{3}Z$/, 'Z'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const e = pm.response.json();",
                  "pm.test(\"Nace en BORRADOR\", () => pm.expect(e.estado).to.eql(\"BORRADOR\"));",
                  "pm.collectionVariables.set(\"eventoId\", e.id);"
                ]
              }
            }
          ]
        },
