' Diagrama de clases de EventHub (#14). Editar y regenerar: ver README.md de esta carpeta.
title EventHub · Clases del microservicio Eventos
' Diagrama de clases del dominio de EventHub (#14)
' Se edita este archivo y se regenera la imagen (ver docs/diagramas/README.md).

skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam nodesep 45
skinparam ranksep 55
skinparam defaultFontName Arial
skinparam ArrowColor #000000
hide circle
skinparam class {
  BackgroundColor #90EE90
  BorderColor #000000
  BorderThickness 1
  HeaderFontStyle bold
  StereotypeFontColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #000000
}

' ===================================================================== EVENTOS
package "Microservicio Eventos" {
  package "eventos.domain" as ev_dom {
    enum EstadoEvento <<enumeración>> {
      BORRADOR
      PUBLICADO
      EN_CURSO
      FINALIZADO
      CANCELADO
    }
    enum TipoBoleta <<enumeración>> {
      GENERAL
      VIP
      ESTUDIANTE
      CORTESIA
    }
    class Evento {
      - id : UUID
      - nombre : String
      - lugar : String
      - fechaInicio : Instant
      - aforoMaximo : int
      - organizadorId : UUID
      - estado : EstadoEvento
      + publicar()
      + iniciar()
      + finalizar()
      + cancelar()
      + cambiarFecha(nueva : Instant)
      + cambiarLugar(nuevo : String)
      + validarCupos() : boolean
    }
    class CategoriaBoleta {
      - tipo : TipoBoleta
      - cupos : int
      - precioBase : long
    }
    interface EventoRepository <<puerto>> {
      + guardar(evento : Evento)
      + buscar(id : UUID) : Optional<Evento>
    }
    interface PublicadorEventos <<puerto>> {
      + eventoActualizado(evento : Evento, cambios : Set<String>)
    }
  }
  package "eventos.application" as ev_app {
    class GestionarEventoUseCase <<caso de uso>> {
      + crear(datos) : Evento
      + publicar(id : UUID)
      + modificar(id : UUID, cambios)
      + cancelar(id : UUID)
    }
  }
  package "eventos.interfaces" as ev_int {
    class EventoController <<entrada>>
  }
  package "eventos.infrastructure" as ev_inf {
    class JdbcEventoRepository <<adaptador>>
    class RabbitPublicadorEventos <<adaptador>>
  }
}

Evento "1" *-- "1..*" CategoriaBoleta : tiene >
Evento --> "1" EstadoEvento : estado
CategoriaBoleta --> "1" TipoBoleta : tipo
GestionarEventoUseCase --> EventoRepository
GestionarEventoUseCase --> PublicadorEventos
GestionarEventoUseCase ..> Evento : gestiona
EventoController --> GestionarEventoUseCase
JdbcEventoRepository ..|> EventoRepository
RabbitPublicadorEventos ..|> PublicadorEventos
PublicadorEventos ..> Evento : publica cambios de


legend right
  **Notación UML**
  Línea con triángulo: herencia ("es un")
  Punteada con triángulo: implementa una interfaz
  Rombo lleno: composición · Rombo vacío: agregación
  Flecha simple: usa / depende de
  Números (1, *, 0..1): multiplicidad
  ----
  Los servicios no comparten clases: se comunican
  por RabbitMQ (ADR-0001) y cada uno tiene su base (ADR-0002).
endlegend
@enduml
