@startuml clases-eventos
' Diagrama de clases de EventHub (#14, actualizado con la implementación del #19).
' Se edita este archivo y se regenera la imagen (ver docs/diagramas/README.md).
title EventHub · Clases del microservicio Eventos

skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam nodesep 60
skinparam ranksep 80
skinparam defaultFontName Arial
skinparam ArrowColor #000000
hide circle
skinparam class {
  BackgroundColor #90EE90
  BorderColor #000000
  BorderThickness 1
  HeaderFontStyle bold
  StereotypeFontColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  BorderThickness 2
  FontStyle bold
  FontSize 14
  BackgroundColor<<interfaces>> #F1E6F7
  BackgroundColor<<application>> #E3EEF9
  BackgroundColor<<domain>> #FFF8DC
  BackgroundColor<<infrastructure>> #ECECEC
  StereotypeFontColor #FFFFFF
  StereotypeFontSize 1
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #000000
}

' ===================================================================== EVENTOS
package "Microservicio Eventos" {
  package "eventos.domain" as ev_dom <<domain>> {
    enum EstadoEvento <<enumeración>> {
      BORRADOR
      PUBLICADO
      EN_CURSO
      FINALIZADO
      CANCELADO
      + puedePasarA(destino : EstadoEvento) : boolean

    }
    enum TipoBoleta <<enumeración>> {
      GENERAL
      VIP
      ESTUDIANTE
      CORTESIA
    }
    enum TipoCambio <<enumeración>> {
      PUBLICADO
      FECHA
      LUGAR
      INVENTARIO
      CANCELADO
    }
    class ValoresAnteriores <<record>> {
      fechaInicio : Instant [0..1]
      lugar : String [0..1]
    }
    class Evento {
      - id : UUID
      - nombre : String
      - lugar : String
      - fechaInicio : Instant
      - aforoMaximo : int
      - organizadorId : UUID
      - organizadorCorreo : String
      - estado : EstadoEvento
      + {static} crear(datos) : Evento
      + {static} reconstruir(id, estado, datos) : Evento
      + editar(datos)
      + publicar()
      + iniciar()
      + finalizar()
      + cancelar()
      + cambiarFecha(nueva : Instant)
      + cambiarLugar(nuevo : String)
    }
    class CategoriaBoleta <<record>> {
      tipo : TipoBoleta
      cupos : int
      precioBase : long
    }
    class ReglaDeNegocioException <<excepción>>
  }
  package "eventos.application" as ev_app <<application>> {
    interface EventoRepository <<puerto>> {
      + guardar(evento : Evento)
      + buscarPorId(id : UUID) : Optional<Evento>
      + buscarPublicadosDesde(ahora : Instant) : List<Evento>
    }
    interface PublicadorEventos <<puerto>> {
      + eventoActualizado(evento : Evento, cambios : Set<TipoCambio>, anteriores : ValoresAnteriores)
    }
    class GestionarEventoUseCase <<caso de uso>> {
      + crear(datos : CrearEventoCommand) : Evento
      + editar(id : UUID, datos : EditarEventoCommand) : Evento
      + publicar(id : UUID) : Evento
      + iniciar(id : UUID) : Evento
      + finalizar(id : UUID) : Evento
      + cancelar(id : UUID) : Evento
      + reprogramar(id : UUID, datos : ReprogramarEventoCommand) : Evento
    }
    class ReprogramarEventoCommand <<record>>
    class ConsultarEventosUseCase <<caso de uso>> {
      + buscarPorId(id : UUID) : Evento
      + catalogo() : List<Evento>
    }
    class CrearEventoCommand <<record>>
    class EditarEventoCommand <<record>>
    class EventoNoEncontradoException <<excepción>>
  }
  package "eventos.interfaces" as ev_int <<interfaces>> {
    class EventoController <<entrada>> {
      + crear(request) : 201
      + consultar(id) : 200
      + editar(id, request) : 200
      + catalogo() : 200
      + publicar(id) : 200
      + iniciar(id) : 200
      + finalizar(id) : 200
      + cancelar(id) : 200
      + reprogramar(id, request) : 200
    }
  package "eventos.infrastructure" as ev_inf <<infrastructure>> {
    class JpaEventoRepository <<adaptador>>
    class EventoMapper
    class EventoEntity <<@Entity>>
    class CategoriaBoletaEmbeddable <<@Embeddable>>
    interface EventoJpaRepository <<Spring Data>>
    class CasosDeUsoConfig <<configuración>>
    class RabbitPublicadorEventos <<adaptador>>
    class EventoActualizadoMensaje <<record>>
    class MensajeriaConfig <<configuración>>
  }
}

' ------------------------------------------------------------------ domain
Evento "1" *-- "1..*" CategoriaBoleta : tiene >
Evento --> "1" EstadoEvento : estado
Evento ..> ReglaDeNegocioException : lanza
CategoriaBoleta --> "1" TipoBoleta : tipo
CategoriaBoleta ..> ReglaDeNegocioException : lanza

' ------------------------------------------------------------- application
GestionarEventoUseCase --> EventoRepository
GestionarEventoUseCase --> PublicadorEventos
GestionarEventoUseCase ..> Evento : gestiona
GestionarEventoUseCase ..> CrearEventoCommand
GestionarEventoUseCase ..> EditarEventoCommand
GestionarEventoUseCase ..> EventoNoEncontradoException : lanza
ConsultarEventosUseCase --> EventoRepository
ConsultarEventosUseCase ..> EventoNoEncontradoException : lanza
PublicadorEventos ..> Evento : publica cambios de
PublicadorEventos ..> TipoCambio
PublicadorEventos ..> ValoresAnteriores

' -------------------------------------------------------------- interfaces
EventoController --> GestionarEventoUseCase
EventoController --> ConsultarEventosUseCase
ManejadorDeErrores ..> ReglaDeNegocioException : 422
ManejadorDeErrores ..> EventoNoEncontradoException : 404
Evento ..> EstadoEvento : puedePasarA
GestionarEventoUseCase ..> ReprogramarEventoCommand
RabbitPublicadorEventos ..> EventoActualizadoMensaje : arma el JSON del contrato

' ---------------------------------------------------------- infrastructure
JpaEventoRepository ..|> EventoRepository
JpaEventoRepository --> EventoJpaRepository
JpaEventoRepository ..> EventoMapper
EventoMapper ..> EventoEntity
EventoMapper ..> Evento : reconstruir
EventoJpaRepository ..> EventoEntity
EventoEntity "1" *-- "1..*" CategoriaBoletaEmbeddable
CasosDeUsoConfig ..> GestionarEventoUseCase : crea
CasosDeUsoConfig ..> ConsultarEventosUseCase : crea
RabbitPublicadorEventos ..|> PublicadorEventos

ev_int -[hidden]down- ev_app
ev_app -[hidden]down- ev_dom
ev_inf -[hidden]down- ev_dom

legend right
  **Notación UML**
  Línea con triángulo: herencia ("es un")
  Punteada con triángulo: implementa una interfaz
  Rombo lleno: composición · Rombo vacío: agregación
  Flecha simple: usa / depende de
  Números (1, *, 0..1): multiplicidad
  ----
  Los servicios no comparten clases: se comunican
  por RabbitMQ (ADR-0001) y cada uno tiene su base (ADR-0002).
  ----
  **Capas (Clean Architecture)**
  Morado: interfaces · Azul: application
  Amarillo: domain · Gris: infrastructure
  Los puertos (repositorios, publicadores) están en application:
  domain no depende de nadie; application depende de domain.
  ----
  **Patrones y principios**
  **DIP**: los casos de uso dependen de puertos (EventoRepository,
     PublicadorEventos), no de PostgreSQL ni RabbitMQ.
  **Dominio puro**: Evento no tiene anotaciones JPA; EventoEntity y
     EventoMapper viven en infrastructure (lo verifica ArquitecturaTest).
  **ISP / CQS**: ConsultarEventosUseCase (lectura) separado de
     GestionarEventoUseCase (escritura).
  **Invariante**: la suma de cupos no supera el aforo; Evento la valida
     al crear y al editar, así no existe un evento inválido.
  **Observer (publish/subscribe)**: Eventos publica evento.actualizado
     en el exchange y no conoce a quienes escuchan (Notificaciones, Boletería).
  **Máquina de estados**: EstadoEvento.puedePasarA define las únicas
     transiciones válidas; Evento no tiene setEstado.
  ----
  **Estado de la implementación**
  Implementado: #19 (CRUD y catálogo) y #20 (ciclo de vida y evento.actualizado).
  Pendiente: el cambio INVENTARIO del contrato (aforo o cupos de un evento publicado).
endlegend
@enduml