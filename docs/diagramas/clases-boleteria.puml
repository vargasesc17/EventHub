@startuml clases-boleteria
' Diagrama de clases del microservicio Boletería (#14), actualizado con lo implementado en #21–#24.
' Se edita este archivo y se regenera la imagen (ver docs/diagramas/README.md).
title EventHub · Clases del microservicio Boletería

skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam nodesep 60
skinparam ranksep 80
skinparam defaultFontName Arial
skinparam ArrowColor #000000
hide circle
hide empty members
skinparam class {
  BackgroundColor #90EE90
  BorderColor #000000
  BorderThickness 1
  HeaderFontStyle bold
  StereotypeFontColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  BorderThickness 2
  FontStyle bold
  FontSize 14
  BackgroundColor<<interfaces>> #F1E6F7
  BackgroundColor<<application>> #E3EEF9
  BackgroundColor<<domain>> #FFF8DC
  BackgroundColor<<infrastructure>> #ECECEC
  StereotypeFontColor #FFFFFF
  StereotypeFontSize 1
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #000000
}

' ===================================================================== BOLETERÍA
package "Microservicio Boletería" {

  package "boleteria.domain" as bo_dom <<domain>> {
    enum EstadoBoleta <<enumeración>> {
      RESERVADA
      ACTIVA
      USADA
      CANCELADA
    }
    enum TipoBoleta <<enumeración>> {
      GENERAL
      VIP
      ESTUDIANTE
      CORTESIA
    }
    enum TipoPrecio <<enumeración>> {
      FIJO
      EARLY_BIRD
      DINAMICO
    }

    abstract class Boleta <<abstracta>> {
      - id : UUID
      - eventoId : UUID
      - compradorId : UUID
      - precioPagado : long
      - estado : EstadoBoleta
      - fechaCompra : Instant
      + {abstract} categoria() : TipoBoleta
      + puedeIngresar() : boolean {final}
    }
    class BoletaGeneral
    class BoletaVIP {
      - beneficios : List<String>
    }
    class BoletaEstudiante {
      - carnetEstudiantil : String
    }
    class BoletaCortesia {
      - emitidaPor : UUID
    }

    abstract class FabricaBoleta <<abstracta>> {
      + {abstract} tipo() : TipoBoleta
      + emitir(compra : Compra, precio : long) : Boleta {final}
      # {abstract} crearBoleta(compra : Compra, precio : long) : Boleta
    }
    class FabricaBoletaGeneral
    class FabricaBoletaVIP
    class FabricaBoletaEstudiante
    class FabricaBoletaCortesia

    interface PrecioStrategy <<interfaz>> {
      + tipo() : TipoPrecio
      + calcular(contexto : ContextoPrecio) : long
    }
    class PrecioFijo
    class PrecioEarlyBird
    class PrecioDinamico
    class ContextoPrecio <<record>> {
      precioBase : long
      cupos : int
      vendidas : int
      fechaCompra : Instant
      parametros : ParametrosPrecio
    }
    class ParametrosPrecio <<record>> {
      fechaLimite : Instant [0..1]
      descuentoPorcentaje : Integer [0..1]
      incrementoMaximoPorcentaje : Integer [0..1]
    }

    class InventarioCategoria <<record>> {
      eventoId : UUID
      categoria : TipoBoleta
      cupos : int
      disponibles : int
      reservadas : int
      vendidas : int
      precioBase : long
      tipoPrecio : TipoPrecio
      parametrosPrecio : ParametrosPrecio
      + contextoPrecio(fechaCompra : Instant) : ContextoPrecio
    }
    class AforoEvento <<record>> {
      eventoId : UUID
      nombre : String
      fechaInicio : Instant
      lugar : String
      organizadorId : UUID
      organizadorCorreo : String
      aforoMaximo : int
      vendidas : int
      alertaEnviada : boolean
      ventasBloqueadas : boolean
      + alcanzaUmbral(porcentaje : int) : boolean
      + aceptaVentas() : boolean
    }
    class Compra <<record>> {
      eventoId : UUID
      categoria : TipoBoleta
      compradorId : UUID
      nombreComprador : String
      correoComprador : String
      carnetEstudiantil : String [0..1]
      emitidaPor : UUID [0..1]
    }
    class CheckIn <<record>> {
      id : UUID
      boletaId : UUID
      eventoId : UUID
      staffId : UUID
      fecha : Instant
    }
    class ReglaDeNegocioException <<excepción>>
  }

  package "boleteria.application" as bo_app <<application>> {
    class ComprarBoletaUseCase <<caso de uso>> {
      + comprar(compra : Compra) : CompraRealizada
    }
    interface CheckInService <<interfaz>> {
      + validar(codigoQr : String, staffId : UUID) : ResultadoCheckIn
    }
    class CheckInUseCase <<caso de uso>>
    class SincronizarEventoUseCase <<caso de uso>> {
      + ejecutar(comando : EventoActualizadoComando) : Resultado
    }
    class ConsultarAforoUseCase <<caso de uso>> {
      + consultar(eventoId : UUID) : AforoConsultado
    }

    class RegistroFabricas {
      + fabricaPara(tipo : TipoBoleta) : FabricaBoleta
    }
    class RegistroEstrategias {
      + estrategiaPara(tipo : TipoPrecio) : PrecioStrategy
    }

    interface InventarioRepository <<puerto>> {
      + crear(inventarios : List<InventarioCategoria>)
      + buscar(eventoId, categoria) : Optional<InventarioCategoria>
      + descontarCupo(eventoId, categoria) : boolean
    }
    interface AforoRepository <<puerto>> {
      + crear(aforo : AforoEvento)
      + buscar(eventoId) : Optional<AforoEvento>
      + actualizarProgramacion(eventoId, fecha, lugar)
      + bloquearVentas(eventoId)
      + sumarVenta(eventoId)
      + marcarAlertaSiAlcanzaUmbral(eventoId, umbral) : boolean
    }
    interface BoletaRepository <<puerto>> {
      + guardar(boleta : Boleta)
      + buscar(boletaId) : Optional<Boleta>
      + marcarUsadaSiActiva(boletaId) : boolean
    }
    interface CheckInRepository <<puerto>> {
      + registrar(checkIn : CheckIn)
    }
    interface MensajeProcesadoRepository <<puerto>> {
      + yaProcesado(messageId) : boolean
      + registrar(messageId, tipo, fecha)
    }
    interface GeneradorQr <<puerto>> {
      + generar(boletaId : UUID) : String
    }
    interface ValidadorQr <<puerto>> {
      + boletaIdSiEsAutentico(codigoQr : String) : Optional<UUID>
    }
    interface PasarelaPagos <<puerto>> {
      + cobrar(compradorId, monto, concepto) : ResultadoPago
    }
    interface PublicadorBoleteria <<puerto>> {
      + boletaComprada(boleta, compra, evento, codigoQr)
      + aforoCritico(evento : AforoEvento, umbral : int)
    }

    class CompraRealizada <<record>> {
      boleta : Boleta
      codigoQr : String
    }
    class ResultadoCheckIn <<record>> {
      aceptado : boolean
      motivo : String [0..1]
      boletaId : UUID [0..1]
    }
    class SinCuposException <<excepción>>
    class PagoRechazadoException <<excepción>>
    class EventoNoEncontradoException <<excepción>>
  }

  package "boleteria.interfaces" as bo_int <<interfaces>> {
    class BoletaController <<entrada>> {
      POST /boletas
      GET /eventos/{id}/aforo
    }
    class CheckInController <<entrada>> {
      POST /checkin
    }
    class ConsumidorEventoActualizado <<entrada>> {
      cola boleteria.evento-actualizado
    }
    class ManejadorDeErrores <<entrada>>
  }

  package "boleteria.infrastructure" as bo_inf <<infrastructure>> {
    class JpaInventarioRepository <<adaptador>>
    class JpaAforoRepository <<adaptador>>
    class JpaBoletaRepository <<adaptador>>
    class JpaCheckInRepository <<adaptador>>
    class JpaMensajeProcesadoRepository <<adaptador>>
    class GeneradorQrHmac <<adaptador>>
    class PasarelaPagosSimulada <<adaptador>>
    class RabbitPublicadorBoleteria <<adaptador>>
  }
}

' ------------------------------------------------------------------ domain
Boleta <|-- BoletaGeneral
Boleta <|-- BoletaVIP
Boleta <|-- BoletaEstudiante
Boleta <|-- BoletaCortesia
Boleta --> "1" EstadoBoleta : estado

FabricaBoleta <|-- FabricaBoletaGeneral
FabricaBoleta <|-- FabricaBoletaVIP
FabricaBoleta <|-- FabricaBoletaEstudiante
FabricaBoleta <|-- FabricaBoletaCortesia
FabricaBoleta ..> Boleta : crea >
FabricaBoleta ..> Compra

PrecioStrategy <|.. PrecioFijo
PrecioStrategy <|.. PrecioEarlyBird
PrecioStrategy <|.. PrecioDinamico
PrecioStrategy ..> ContextoPrecio
ContextoPrecio --> ParametrosPrecio
InventarioCategoria ..> ContextoPrecio : arma >
InventarioCategoria --> TipoPrecio
Boleta "1" -- "0..1" CheckIn : registra ingreso >

' ------------------------------------------------------------- application
ComprarBoletaUseCase --> AforoRepository
ComprarBoletaUseCase --> InventarioRepository
ComprarBoletaUseCase --> BoletaRepository
ComprarBoletaUseCase --> RegistroEstrategias
ComprarBoletaUseCase --> RegistroFabricas
ComprarBoletaUseCase --> PasarelaPagos
ComprarBoletaUseCase --> GeneradorQr
ComprarBoletaUseCase --> PublicadorBoleteria
ComprarBoletaUseCase ..> CompraRealizada
RegistroFabricas o-- "1..*" FabricaBoleta
RegistroEstrategias o-- "1..*" PrecioStrategy

CheckInService <|.. CheckInUseCase
CheckInService ..> ResultadoCheckIn
CheckInUseCase --> ValidadorQr
CheckInUseCase --> BoletaRepository
CheckInUseCase --> CheckInRepository

SincronizarEventoUseCase --> MensajeProcesadoRepository
SincronizarEventoUseCase --> AforoRepository
SincronizarEventoUseCase --> InventarioRepository
ConsultarAforoUseCase --> AforoRepository
ConsultarAforoUseCase --> InventarioRepository

' -------------------------------------------------------------- interfaces
BoletaController --> ComprarBoletaUseCase
BoletaController --> ConsultarAforoUseCase
CheckInController --> CheckInService
ConsumidorEventoActualizado --> SincronizarEventoUseCase

' ---------------------------------------------------------- infrastructure
JpaInventarioRepository ..|> InventarioRepository
JpaAforoRepository ..|> AforoRepository
JpaBoletaRepository ..|> BoletaRepository
JpaCheckInRepository ..|> CheckInRepository
JpaMensajeProcesadoRepository ..|> MensajeProcesadoRepository
GeneradorQrHmac ..|> GeneradorQr
GeneradorQrHmac ..|> ValidadorQr
PasarelaPagosSimulada ..|> PasarelaPagos
RabbitPublicadorBoleteria ..|> PublicadorBoleteria

bo_int -[hidden]down- bo_app
bo_app -[hidden]down- bo_dom
bo_inf -[hidden]down- bo_dom

legend right
  **Notación UML**
  Línea con triángulo: herencia ("es un")
  Punteada con triángulo: implementa una interfaz
  Rombo vacío: agregación · Flecha simple: usa / depende de
  Números (1, *, 0..1): multiplicidad
  ----
  Los servicios no comparten clases: se comunican
  por RabbitMQ (ADR-0001) y cada uno tiene su base (ADR-0002).
  ----
  **Capas (Clean Architecture)**
  Morado: interfaces · Azul: application
  Amarillo: domain · Gris: infrastructure
  Los puertos están en application: domain no depende de nadie.
  ArquitecturaTest (ArchUnit) verifica estas reglas en cada build.
  ----
  **Patrones y principios**
  **Factory Method** (#21): cada FabricaBoleta crea su tipo de boleta;
     un tipo nuevo no cambia ComprarBoletaUseCase (OCP).
  **Strategy** (#22): PrecioStrategy calcula el precio sin if/else;
     la estrategia se guarda por categoría (FIJO por defecto).
  **DIP** (#23): ComprarBoletaUseCase solo depende de abstracciones
     (puertos y registros), no de PostgreSQL, RabbitMQ ni HMAC.
  **Concurrencia** (ADR-0003): descontarCupo y marcarAlertaSiAlcanzaUmbral
     son UPDATE condicionales atómicos.
  **LSP** (#24): cualquier Boleta pasa por el mismo check-in;
     puedeIngresar() es final.
  **ISP** (#24): CheckInService separada de la compra.
  **QR** (ADR-0004): GeneradorQrHmac genera y valida boletaId.firma.
  ----
  **No implementado en esta entrega**
  Reservas de 24 horas (RF-01), configurar el tipo de precio
  desde la API y el cambio INVENTARIO del contrato.
endlegend
@enduml
