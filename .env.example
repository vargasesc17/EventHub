# Copia este archivo como .env (cp .env.example .env) y cambia las contraseñas si quieres.
# .env está en .gitignore: nunca subas credenciales reales al repo.

# RabbitMQ (panel en http://localhost:15672)
RABBITMQ_USER=eventhub
RABBITMQ_PASSWORD=cambiar-esto

# PostgreSQL: usuario administrador
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=cambiar-esto

# Un usuario por microservicio, con acceso solo a su base (ADR-0002)
EVENTOS_DB_USER=eventos
EVENTOS_DB_PASSWORD=cambiar-esto
BOLETERIA_DB_USER=boleteria
BOLETERIA_DB_PASSWORD=cambiar-esto
NOTIFICACIONES_DB_USER=notificaciones
NOTIFICACIONES_DB_PASSWORD=cambiar-esto
